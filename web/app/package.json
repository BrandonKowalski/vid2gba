{
  "name": "vid2gba-web",
  "license": "MIT",
  "scripts": {
    "wasm": "wasm-pack build ../wasm --target web --out-dir ../app/src/wasm-pkg --out-name vid2gba",
    "mgba": "node scripts/copy-mgba.mjs",
    "dev": "npm run wasm && npm run mgba && vite",
    "build": "npm run wasm && npm run mgba && tsc --noEmit && vite build",
    "preview": "vite preview --port 4173 --strictPort",
    "test:e2e": "playwright test"
  },
  "type": "module",
  "dependencies": {
    "@fontsource/ibm-plex-mono": "^5.3.0",
    "@fontsource/press-start-2p": "^5.3.0",
    "@thenick775/mgba-wasm": "^2.5.1",
    "mediabunny": "^1.61.3"
  },
  "devDependencies": {
    "@playwright/test": "^1.63.0",
    "typescript": "^7.0.2",
    "vite": "^8.3.3"
  },
  "private": true
}
